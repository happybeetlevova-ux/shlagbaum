<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="6dp" android:background="@drawable/widget_bg">
    <FrameLayout android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp">
        <ImageView android:id="@+id/bg1" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitXY"
            android:src="@drawable/btn_shape" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/icon1" android:layout_width="28dp"
                android:layout_height="28dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label1" style="@style/WidgetLabel" android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp">
        <ImageView android:id="@+id/bg2" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitXY"
            android:src="@drawable/btn_shape" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/icon2" android:layout_width="28dp"
                android:layout_height="28dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label2" style="@style/WidgetLabel" android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp">
        <ImageView android:id="@+id/bg3" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitXY"
            android:src="@drawable/btn_shape" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/icon3" android:layout_width="28dp"
                android:layout_height="28dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label3" style="@style/WidgetLabel" android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
